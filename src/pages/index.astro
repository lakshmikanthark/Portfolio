<script>
	/* =========================================================
	   UTILITY FUNCTIONS
	   ========================================================= */

	const clamp = (
		value: number,
		min: number,
		max: number
	): number => {

		return Math.min(
			Math.max(
				value,
				min
			),
			max
		);
	};


	const smoothstep = (
		value: number
	): number => {

		const x =
			clamp(
				value,
				0,
				1
			);

		return (
			x *
			x *
			(3 - 2 * x)
		);
	};


	/* =========================================================
	   THESIS
	   ========================================================= */

	const initThesis = () => {

		const thesis =
			document.querySelector<HTMLElement>(
				'.thesis'
			);

		const thesisText =
			document.querySelector<HTMLElement>(
				'.thesis-text'
			);

		const system =
			document.querySelector<HTMLElement>(
				'[data-thesis-system]'
			);

		if (
			!thesis ||
			!thesisText ||
			!system
		) {
			return;
		}


		/* -------------------------
		   Convert text into letters
		   ------------------------- */

		const lines =
			thesisText.querySelectorAll<HTMLElement>(
				'.thesis-line'
			);

		lines.forEach((line) => {

			if (
				line.querySelector(
					'.thesis-letter'
				)
			) {
				return;
			}

			const text =
				line.textContent ?? '';

			line.textContent = '';

			for (
				const character of [...text]
			) {

				const letter =
					document.createElement(
						'span'
					);

				letter.className =
					'thesis-letter';

				letter.textContent =
					character === ' '
						? '\u00A0'
						: character;

				line.appendChild(
					letter
				);
			}
		});


		const letters = [
			...thesisText.querySelectorAll<HTMLElement>(
				'.thesis-letter'
			)
		];


		const stages = [
			...system.querySelectorAll<HTMLElement>(
				'.system-step'
			)
		];


		if (
			!letters.length ||
			!stages.length
		) {
			return;
		}


		/* -------------------------
		   Initial state
		   ------------------------- */

		letters.forEach(
			(letter) => {

				letter.style.opacity =
					'0.1';

				letter.style.filter =
					'blur(0.35px)';
			}
		);


		stages.forEach(
			(stage) => {

				stage.classList.remove(
					'is-active'
				);

				stage.classList.remove(
					'is-complete'
				);
			}
		);


		let ticking = false;


		/* -------------------------
		   Update Thesis
		   ------------------------- */

		const update = () => {

			ticking = false;


			const rect =
				thesis.getBoundingClientRect();


			const sectionTop =
				window.scrollY +
				rect.top;


			/*
				The Thesis is split into
				two sequential phases:

				PHASE 1
				Sentence reveal.

				PHASE 2
				DISCOVER → ACCELERATE → BUILD.
			*/

			const revealDistance =
				window.innerHeight *
				2.5;


			const progress =
				clamp(
					(
						window.scrollY -
						sectionTop
					) /
						revealDistance,
					0,
					1
				);


			/* -------------------------
			   PHASE 1 — SENTENCE
			   ------------------------- */

			const sentenceEnd =
				0.62;


			const sentenceProgress =
				clamp(
					progress /
						sentenceEnd,
					0,
					1
				);


			const total =
				letters.length;


			const spread =
				1 /
				Math.max(
					total - 1,
					1
				);


			const revealWidth =
				spread *
				3.5;


			letters.forEach(
				(letter, index) => {

					const position =
						index *
						spread;


					const local =
						(
							sentenceProgress -
							position
						) /
						revealWidth;


					let illumination =
						smoothstep(
							local + 0.5
						);


					/*
						Guarantee that the final
						character reaches full
						brightness before the
						system starts.
					*/

					if (
						sentenceProgress >=
						0.985
					) {
						illumination = 1;
					}


					const opacity =
						0.1 +
						(
							illumination *
							0.9
						);


					const blur =
						(
							1 -
							illumination
						) *
						0.35;


					letter.style.opacity =
						opacity.toFixed(3);


					letter.style.filter =
						`blur(${blur.toFixed(3)}px)`;
				}
			);


			/* -------------------------
			   PHASE 2 — SYSTEM
			   ------------------------- */

			/*
				The system remains completely
				grey until the sentence phase
				has finished.
			*/

			const systemProgress =
				clamp(
					(
						progress -
						sentenceEnd
					) /
						(
							1 -
							sentenceEnd
						),
					0,
					1
				);


			if (
				systemProgress <= 0
			) {

				stages.forEach(
					(stage) => {

						stage.classList.remove(
							'is-active'
						);

						stage.classList.remove(
							'is-complete'
						);
					}
				);

				return;
			}


			/*
				Only now does the scroll
				progress through the three
				system stages.
			*/

			const stageCount =
				stages.length;


			let activeStage =
				Math.floor(
					systemProgress *
					stageCount
				);


			if (
				activeStage >=
				stageCount
			) {
				activeStage =
					stageCount - 1;
			}


			stages.forEach(
				(stage, index) => {

					const active =
						index ===
						activeStage;


					const complete =
						index <
						activeStage;


					stage.classList.toggle(
						'is-active',
						active
					);


					stage.classList.toggle(
						'is-complete',
						complete
					);
				}
			);
		};


		const requestUpdate = () => {

			if (ticking) {
				return;
			}


			ticking = true;


			requestAnimationFrame(
				update
			);
		};


		update();


		window.addEventListener(
			'scroll',
			requestUpdate,
			{
				passive: true
			}
		);


		window.addEventListener(
			'resize',
			requestUpdate
		);
	};


	/* =========================================================
	   SCROLL PROGRESS
	   ========================================================= */

	const initScrollProgress = () => {

		const bar =
			document.querySelector<HTMLElement>(
				'.scroll-progress-bar'
			);

		if (!bar) {
			return;
		}


		let current = 0;

		let target = 0;

		let animationFrame:
			number | null = null;


		const updateTarget = () => {

			const maximum =
				document.documentElement
					.scrollHeight -
				window.innerHeight;


			target =
				maximum > 0
					? clamp(
						window.scrollY /
							maximum,
						0,
						1
					)
					: 0;
		};


		const animate = () => {

			current +=
				(
					target -
					current
				) *
				0.08;


			bar.style.transform =
				`scaleY(${current})`;


			if (
				Math.abs(
					target -
					current
				) >
				0.0001
			) {

				animationFrame =
					requestAnimationFrame(
						animate
					);

			} else {

				current =
					target;

				bar.style.transform =
					`scaleY(${current})`;

				animationFrame =
					null;
			}
		};


		const requestUpdate = () => {

			updateTarget();


			if (
				animationFrame ===
				null
			) {

				animationFrame =
					requestAnimationFrame(
						animate
					);
			}
		};


		requestUpdate();


		window.addEventListener(
			'scroll',
			requestUpdate,
			{
				passive: true
			}
		);


		window.addEventListener(
			'resize',
			requestUpdate
		);
	};


	/* =========================================================
	   NAVIGATION
	   ========================================================= */

	const initNavigation = () => {

		const nav =
			document.querySelector<HTMLElement>(
				'.site-nav'
			);

		const current =
			document.querySelector<HTMLElement>(
				'.site-nav-current'
			);

		const links = [
			...document.querySelectorAll<HTMLAnchorElement>(
				'.site-nav-links a'
			)
		];


		const sections = [
			{
				element:
					document.querySelector<HTMLElement>(
						'.hero'
					),
				number: '00',
				id: ''
			},

			{
				element:
					document.querySelector<HTMLElement>(
						'.thesis'
					),
				number: '01',
				id: ''
			},

			{
				element:
					document.querySelector<HTMLElement>(
						'#work'
					),
				number: '02',
				id: 'work'
			},

			{
				element:
					document.querySelector<HTMLElement>(
						'#growth'
					),
				number: '03',
				id: 'growth'
			},

			{
				element:
					document.querySelector<HTMLElement>(
						'#tea'
					),
				number: '04',
				id: 'tea'
			},

			{
				element:
					document.querySelector<HTMLElement>(
						'#contact'
					),
				number: '05',
				id: 'contact'
			}
		].filter(
			(section) =>
				Boolean(
					section.element
				)
		);


		let ticking = false;


		const update = () => {

			ticking = false;


			const activationPoint =
				window.innerHeight *
				0.42;


			let active =
				sections[0];


			for (
				const section of sections
			) {

				if (!section.element) {
					continue;
				}


				const rect =
					section.element.getBoundingClientRect();


				if (
					rect.top <=
					activationPoint
				) {

					active =
						section;
				}
			}


			if (
				current &&
				active
			) {

				current.textContent =
					active.number;
			}


			if (nav) {

				nav.classList.toggle(
					'is-scrolled',
					window.scrollY > 28
				);
			}


			links.forEach(
				(link) => {

					const target =
						link.dataset.target ??
						'';


					link.classList.toggle(
						'is-active',
						Boolean(
							active?.id &&
							target ===
								active.id
						)
					);
				}
			);
		};


		const requestUpdate = () => {

			if (ticking) {
				return;
			}


			ticking = true;


			requestAnimationFrame(
				update
			);
		};


		update();


		window.addEventListener(
			'scroll',
			requestUpdate,
			{
				passive: true
			}
		);


		window.addEventListener(
			'resize',
			requestUpdate
		);
	};


	/* =========================================================
	   HERO DEPTH
	   ========================================================= */

	const initHeroDepth = () => {

		const hero =
			document.querySelector<HTMLElement>(
				'.hero-inner'
			);

		if (!hero) {
			return;
		}


		const reducedMotion =
			window.matchMedia(
				'(prefers-reduced-motion: reduce)'
			).matches;


		if (reducedMotion) {
			return;
		}


		let ticking = false;


		const update = () => {

			ticking = false;


			const distance =
				Math.min(
					window.scrollY,
					window.innerHeight
				);


			const offset =
				distance *
				0.018;


			hero.style.transform =
				`translate3d(
					0,
					${-offset}px,
					0
				)`;
		};


		const requestUpdate = () => {

			if (ticking) {
				return;
			}


			ticking = true;


			requestAnimationFrame(
				update
			);
		};


		update();


		window.addEventListener(
			'scroll',
			requestUpdate,
			{
				passive: true
			}
		);


		window.addEventListener(
			'resize',
			requestUpdate
		);
	};


	/* =========================================================
	   GROWTH STAGE PROGRESSION
	   ========================================================= */

	const initGrowthStages = () => {

		const growth =
			document.querySelector<HTMLElement>(
				'#growth'
			);

		if (!growth) {
			return;
		}


		const stages = [
			...growth.querySelectorAll<HTMLElement>(
				'.growth-stage'
			)
		];


		if (!stages.length) {
			return;
		}


		/*
			The Growth section behaves like the Thesis:

			- the section becomes a long scroll scene
			- the inner container stays sticky
			- only one stage highlights at a time
			- the stages progress sequentially
		*/

		let ticking = false;


		const reset = () => {

			stages.forEach(
				(stage) => {

					stage.classList.remove(
						'is-active'
					);

					stage.classList.remove(
						'is-complete'
					);
				}
			);
		};


		reset();


		const update = () => {

			ticking = false;


			const rect =
				growth.getBoundingClientRect();


			const sectionTop =
				window.scrollY +
				rect.top;


			/*
				The Growth section itself is 320svh
				while the inner container is sticky.
			*/

			const sceneDistance =
				Math.max(
					growth.offsetHeight -
					window.innerHeight,
					1
				);


			const sceneProgress =
				clamp(
					(
						window.scrollY -
						sectionTop
					) /
						sceneDistance,
					0,
					1
				);


			/*
				Give the first and last portions
				of the scene a little breathing room.
			*/

			const progressionStart =
				0.12;

			const progressionEnd =
				0.92;


			const progress =
				clamp(
					(
						sceneProgress -
						progressionStart
					) /
						(
							progressionEnd -
							progressionStart
						),
					0,
					1
				);


			/*
				Before the Growth scene reaches its
				progression window, every word is grey.
			*/

			if (
				sceneProgress <=
				progressionStart
			) {

				reset();

				return;
			}


			const stageCount =
				stages.length;


			let activeStage =
				Math.floor(
					progress *
					stageCount
				);


			if (
				activeStage >=
				stageCount
			) {

				activeStage =
					stageCount - 1;
			}


			stages.forEach(
				(stage, index) => {

					const active =
						index ===
						activeStage;


					const complete =
						index <
						activeStage;


					stage.classList.toggle(
						'is-active',
						active
					);


					stage.classList.toggle(
						'is-complete',
						complete
					);
				}
			);
		};


		const requestUpdate = () => {

			if (ticking) {
				return;
			}


			ticking = true;

			requestAnimationFrame(
				update
			);
		};


		update();


		window.addEventListener(
			'scroll',
			requestUpdate,
			{
				passive: true
			}
		);


		window.addEventListener(
			'resize',
			requestUpdate
		);
	};


	/* =========================================================
	   TEA AMBIENT MOTION
	   ========================================================= */

	const initTeaFloatingWords = () => {

		const fragments = [
			...document.querySelectorAll<HTMLElement>(
				'.tea-fragment'
			)
		];


		if (!fragments.length) {
			return;
		}


		const reducedMotion =
			window.matchMedia(
				'(prefers-reduced-motion: reduce)'
			).matches;


		fragments.forEach(
			(element) => {

				element.style.opacity =
					'1';

				element.style.visibility =
					'visible';

				element.style.display =
					'block';

				element.style.transform =
					'translate3d(0, 0, 0)';
			}
		);


		if (reducedMotion) {
			return;
		}


		const speeds = [
			0.70,
			0.90,
			0.75,
			0.82
		];


		const phases = [
			0,
			1.8,
			3.4,
			5
		];


		let animationFrame:
			number | null = null;


		const animate = (
			time: number
		) => {

			const seconds =
				time / 1000;


			fragments.forEach(
				(element, index) => {

					const speed =
						speeds[index] ??
						0.8;


					const phase =
						phases[index] ??
						0;


					const y =
						Math.sin(
							seconds *
								0.55 *
								speed +
								phase
						) *
						7;


					element.style.transform =
						`translate3d(
							0,
							${y.toFixed(2)}px,
							0
						)`;
				}
			);


			animationFrame =
				requestAnimationFrame(
					animate
				);
		};


		animationFrame =
			requestAnimationFrame(
				animate
			);


		document.addEventListener(
			'visibilitychange',
			() => {

				if (
					document.visibilityState ===
					'hidden'
				) {

					if (
						animationFrame !==
						null
					) {

						cancelAnimationFrame(
							animationFrame
						);

						animationFrame =
							null;
					}

					return;
				}


				if (
					animationFrame ===
					null
				) {

					animationFrame =
						requestAnimationFrame(
							animate
						);
				}
			}
		);
	};


	/* =========================================================
	   BACK TO TOP
	   ========================================================= */

	const initBackToTop = () => {

		const button =
			document.querySelector<HTMLButtonElement>(
				'.back-to-top'
			);


		if (!button) {
			return;
		}


		let ticking = false;


		const update = () => {

			ticking = false;


			button.classList.toggle(
				'is-visible',
				window.scrollY >
					window.innerHeight *
					0.55
			);
		};


		const requestUpdate = () => {

			if (ticking) {
				return;
			}


			ticking = true;


			requestAnimationFrame(
				update
			);
		};


		button.addEventListener(
			'click',
			() => {

				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			}
		);


		update();


		window.addEventListener(
			'scroll',
			requestUpdate,
			{
				passive: true
			}
		);
	};


	/* =========================================================
	   RUN EVERYTHING
	   ========================================================= */

	initThesis();
	initScrollProgress();
	initNavigation();
	initHeroDepth();
	initGrowthStages();
	initTeaFloatingWords();
	initBackToTop();
</script>